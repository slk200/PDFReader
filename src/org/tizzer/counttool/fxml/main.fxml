<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.input.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.net.URL?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8.0.172-ea"
            maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="800.0" prefWidth="1280.0"
            fx:controller="org.tizzer.counttool.controller.MainController">
    <padding>
        <Insets top="8.0" right="12.0" bottom="12.0" left="12.0"/>
    </padding>

    <!-- ============================ 顶部菜单栏 ============================ -->
    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="16.0"/>
            </BorderPane.margin>
            <padding>
                <Insets left="6" right="6" top="2" bottom="2"/>
            </padding>
            <Menu mnemonicParsing="false" text="文件">
                <MenuItem mnemonicParsing="false" onAction="#scanFile" text="打开文件夹">
                    <accelerator>
                        <KeyCodeCombination alt="UP" code="O" control="DOWN" meta="UP" shift="UP" shortcut="UP"/>
                    </accelerator>
                </MenuItem>
                <SeparatorMenuItem mnemonicParsing="false"/>
                <MenuItem mnemonicParsing="false" onAction="#exit" text="退出">
                    <accelerator>
                        <KeyCodeCombination alt="UP" code="Q" control="DOWN" meta="UP" shift="UP" shortcut="UP"/>
                    </accelerator>
                </MenuItem>
            </Menu>
            <Menu mnemonicParsing="false" text="编辑">
                <MenuItem mnemonicParsing="false" onAction="#setting" text="设置">
                    <accelerator>
                        <KeyCodeCombination alt="DOWN" code="S" control="DOWN" meta="UP" shift="UP" shortcut="UP"/>
                    </accelerator>
                </MenuItem>
                <MenuItem mnemonicParsing="false" onAction="#changeTheme" text="主题">
                    <accelerator>
                        <KeyCodeCombination alt="DOWN" code="T" control="DOWN" meta="UP" shift="UP" shortcut="UP"/>
                    </accelerator>
                </MenuItem>
                <SeparatorMenuItem mnemonicParsing="false"/>
                <MenuItem mnemonicParsing="false" onAction="#execute" text="执行">
                    <accelerator>
                        <KeyCodeCombination alt="UP" code="E" control="DOWN" meta="UP" shift="UP" shortcut="UP"/>
                    </accelerator>
                </MenuItem>
                <MenuItem mnemonicParsing="false" onAction="#reset" text="恢复">
                    <accelerator>
                        <KeyCodeCombination alt="UP" code="R" control="DOWN" meta="UP" shift="UP" shortcut="UP"/>
                    </accelerator>
                </MenuItem>
            </Menu>
            <Menu mnemonicParsing="false" text="帮助">
                <MenuItem mnemonicParsing="false" onAction="#about" text="关于">
                    <accelerator>
                        <KeyCodeCombination alt="UP" code="F12" control="DOWN" meta="UP" shift="UP" shortcut="UP"/>
                    </accelerator>
                </MenuItem>
            </Menu>
        </MenuBar>
    </top>

    <!-- ============================ 左侧操作区 ============================ -->
    <left>
        <VBox styleClass="glass-panel" spacing="10.0" prefWidth="345.0" minWidth="300.0"
              BorderPane.alignment="TOP_LEFT">
            <BorderPane.margin>
                <Insets right="12.0"/>
            </BorderPane.margin>
            <padding>
                <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
            </padding>

            <!-- 文件夹选择行 -->
            <HBox spacing="6.0" alignment="CENTER_LEFT">
                <TextField fx:id="scanField" disable="true" promptText="选择文件夹" HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#scanFile" prefWidth="55.0" text="浏览"/>
                <Button mnemonicParsing="false" onAction="#execute" prefWidth="55.0" text="执行"/>
            </HBox>

            <!-- 文件类型统计 -->
            <GridPane hgap="20" vgap="20" alignment="CENTER_LEFT" maxWidth="Infinity">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.4"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints vgrow="SOMETIMES"/>
                    <RowConstraints vgrow="SOMETIMES"/>
                </rowConstraints>
                <HBox spacing="6.0" alignment="CENTER_LEFT">
                    <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@/image/word@64px.png"/>
                    </ImageView>
                    <Label fx:id="wordNum" text="0"/>
                </HBox>
                <HBox spacing="6.0" alignment="CENTER_LEFT" GridPane.columnIndex="1">
                    <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@/image/excel@64px.png"/>
                    </ImageView>
                    <Label fx:id="excelNum" text="0"/>
                </HBox>
                <HBox spacing="6.0" alignment="CENTER_LEFT" GridPane.columnIndex="2">
                    <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@/image/ppt@64px.png"/>
                    </ImageView>
                    <Label fx:id="pptNum" text="0"/>
                </HBox>
                <HBox spacing="6.0" alignment="CENTER_LEFT" GridPane.rowIndex="1">
                    <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@/image/pdf@64px.png"/>
                    </ImageView>
                    <Label fx:id="pdfNum" text="0"/>
                </HBox>
                <HBox spacing="6.0" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@/image/pic@64px.png"/>
                    </ImageView>
                    <Label fx:id="picNum" text="0"/>
                </HBox>
                <HBox spacing="6.0" alignment="CENTER_LEFT" GridPane.columnIndex="2" GridPane.rowIndex="1">
                    <ImageView fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@/image/other@64px.png"/>
                    </ImageView>
                    <Label fx:id="otherNum" text="0"/>
                </HBox>
            </GridPane>

            <!-- 总价 -->
            <Label fx:id="totalPrice"  text="总价(页数x单价x份数+特殊)："/>

            <!-- 计价输入行（自动换行，避免重叠） -->
            <FlowPane hgap="6.0" vgap="6.0" alignment="CENTER_LEFT">
                <Spinner fx:id="pageSpinner" editable="true" prefWidth="82.0" prefHeight="26.0">
                    <tooltip>
                        <Tooltip text="页数"/>
                    </tooltip>
                </Spinner>
                <Label text="x"/>
                <Spinner fx:id="priceSpinner" editable="true" prefWidth="82.0" prefHeight="26.0">
                    <tooltip>
                        <Tooltip text="单价"/>
                    </tooltip>
                </Spinner>
                <Label text="x"/>
                <Spinner fx:id="numSpinner" editable="true" prefWidth="82.0" prefHeight="26.0">
                    <tooltip>
                        <Tooltip text="份数"/>
                    </tooltip>
                </Spinner>
                <Label text="+"/>
                <Spinner fx:id="specSpinner" editable="true" prefWidth="82.0" prefHeight="26.0">
                    <tooltip>
                        <Tooltip text="特殊"/>
                    </tooltip>
                </Spinner>
                <Label text="  "/>
                <Button mnemonicParsing="false" onAction="#sum" prefWidth="60.0" text="累计"/>
            </FlowPane>

            <!-- 累计历史 -->
            <ListView fx:id="sumList" VBox.vgrow="ALWAYS" minHeight="80.0" prefHeight="130.0">
                <contextMenu>
                    <ContextMenu>
                        <items>
                            <MenuItem mnemonicParsing="false" onAction="#deleteSum" text="删除"/>
                        </items>
                    </ContextMenu>
                </contextMenu>
            </ListView>

            <!-- 附加项选择行 -->
            <HBox spacing="6.0" alignment="CENTER_LEFT">
                <ComboBox fx:id="extraComboBox" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button mnemonicParsing="false" onAction="#addExtra" prefWidth="55.0" text="添加"/>
            </HBox>

            <!-- 附加项表格 -->
            <TableView fx:id="extraTable" editable="true" VBox.vgrow="ALWAYS" minHeight="120.0">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="extraColumn" editable="false" prefWidth="75.0" sortable="false" text="附加项"/>
                    <TableColumn fx:id="priceColumn" editable="false" prefWidth="75.0" sortable="false" text="单价"/>
                    <TableColumn fx:id="numColumn" prefWidth="20.0" sortable="false" text="份数"/>
                </columns>
                <contextMenu>
                    <ContextMenu>
                        <items>
                            <MenuItem mnemonicParsing="false" onAction="#deleteExtra" text="删除"/>
                        </items>
                    </ContextMenu>
                </contextMenu>
            </TableView>
        </VBox>
    </left>

    <!-- ============================ 中部文件列表 ============================ -->
    <center>
        <VBox styleClass="glass-panel" spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
            </padding>
            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Label fx:id="totalPage" text="总页数："/>
                <ProgressIndicator fx:id="totalProgress" prefHeight="23.0" prefWidth="23.0" visible="false"/>
            </HBox>
            <TableView fx:id="pendedFileTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="typeColumn" editable="false" maxWidth="40.0" minWidth="40.0" prefWidth="40.0"
                                 sortable="false" text="类型"/>
                    <TableColumn fx:id="nameColumn" editable="false" minWidth="0.0" prefWidth="101.0" sortable="false"
                                 text="文件名"/>
                    <TableColumn fx:id="stateColumn" editable="false" maxWidth="150.0" minWidth="150.0"
                                 prefWidth="150.0" sortable="false" text="状态"/>
                    <TableColumn fx:id="pageColumn" editable="false" maxWidth="60.0" minWidth="60.0" prefWidth="60.0"
                                 sortable="false" text="页数"/>
                    <TableColumn fx:id="pathColumn" editable="false" prefWidth="229.0" sortable="false" text="文件路径"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <contextMenu>
                    <ContextMenu>
                        <items>
                            <MenuItem mnemonicParsing="false" onAction="#openFile" text="打开文件"/>
                            <MenuItem mnemonicParsing="false" onAction="#openPDFFile" text="打开PDF文件"/>
                            <MenuItem mnemonicParsing="false" onAction="#showInExplore" text="打开文件夹"/>
                        </items>
                    </ContextMenu>
                </contextMenu>
            </TableView>
        </VBox>
    </center>

    <stylesheets>
        <URL value="@/org/tizzer/counttool/css/custom.css"/>
    </stylesheets>
</BorderPane>
