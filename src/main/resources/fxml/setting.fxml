<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<VBox xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8.0.501"
      styleClass="glass-panel" spacing="8.0" prefWidth="350.0" prefHeight="430.0" minWidth="300.0"
      fx:controller="controller.SettingController">
    <padding>
        <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
    </padding>

    <Label text="设置默认位置"/>
    <HBox spacing="6.0" alignment="CENTER_LEFT">
        <TextField fx:id="defaultPlace" disable="true" promptText="文件的接收位置" HBox.hgrow="ALWAYS"/>
        <Button mnemonicParsing="false" onAction="#scanFile" prefWidth="55.0" text="浏览"/>
    </HBox>

    <Label fx:id="errorTip"/>

    <Label text="附加项"/>
    <TableView fx:id="extraTable" editable="true" VBox.vgrow="ALWAYS" minHeight="160.0">
        <columns>
            <TableColumn fx:id="nameColumn" editable="false" prefWidth="75.0" sortable="false" text="选项"/>
            <TableColumn fx:id="priceColumn" prefWidth="75.0" sortable="false" text="单价"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <contextMenu>
            <ContextMenu>
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#deleteExtra" text="删除"/>
                </items>
            </ContextMenu>
        </contextMenu>
    </TableView>

    <HBox spacing="6.0" alignment="CENTER_LEFT">
        <TextField fx:id="nameField" promptText="名称" HBox.hgrow="ALWAYS">
            <tooltip>
                <Tooltip text="建议长度10个字符，超出部分显示..."/>
            </tooltip>
        </TextField>
        <Spinner fx:id="priceSpinner" editable="true" prefWidth="90.0"/>
        <Button mnemonicParsing="false" onAction="#addExtra" prefWidth="55.0" text="添加"/>
    </HBox>

    <stylesheets>
        <URL value="@/css/custom.css"/>
    </stylesheets>
</VBox>
